*.py[cod]
*.egg-info/
.venv/
venv/

# 密钥与环境
.env
*.local

# 备份与临时产物
*.bak
*.bak.*
chroma_db.bak*

# 历史遗留的重复向量库：真正的库只有根目录 chroma_db/（main.py 的 PERSIST_DIR）
# data/ 下只保留 knowledge_base/，其余一旦再生成不要入库
data/chroma_db/
data/vector_store/
assets_src/
tools/*.json
backend/*.log

# 微信开发者工具个人配置（含本机路径，不该进仓库）
miniprogram/project.private.config.json

# 用户反馈原始数据：含 openid 与提问原文，只在机器上留，不进仓库
data/feedback/
# 全量问句原始日志：含提问原文，只在机器上留，不进仓库
data/query_log/

# 联网 100 问评测用的向量库副本（约 28MB，脚本会自动重建，不进仓库）
data/_eval_chroma_tmp/
tools/_web100_report.txt
tools/_web100_run.log

# 系统
.DS_Store
Thumbs.db

# 答案库向量缓存：随种子/嵌入后端指纹重建，二进制不入库
data/knowledge_table/answer_bank_cache.npz
