# 复制为 .env 后填写（.env 已在 .gitignore，不会进仓库）
# 云端部署时不要用本文件，密钥填在云托管控制台的「环境变量」里。

# ── 生成（问答大模型）──
# 智谱 GLM-4-Flash：open.bigmodel.cn 注册即送额度，glm-4-flash 长期免费
GEN_BACKEND=zhipu
API_BASE=https://open.bigmodel.cn/api/paas/v4
MODEL=glm-4-flash
API_KEY=

# ── 嵌入（检索向量）──
# cloud = 硅基流动 BAAI/bge-m3（1024 维，免费，国内直连）
EMBED_BACKEND=cloud
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
# 查询期嵌入超时（秒）：必须远小于小程序 15s 硬上限，超时后自动降级纯 BM25
EMBED_TIMEOUT=8

# ── 其他 ──
# 后端在 15s 前主动降级的阈值
QUERY_TIMEOUT=12
# 可选：只允许这些 openid 提问（逗号分隔，留空=不限制）
OPENID_ALLOWLIST=

# ── 内容安全（上架审核硬要求）──
# 调用微信 msg_sec_check 检测用户提问与 AI 答案。
# 前提：云托管控制台「云调用 → 云调用权限配置」登记 /wxa/msg_sec_check。
# 本地开发自动跳过（检测不到容器内的 token 文件），无需改动本项。
SEC_CHECK_ENABLE=1
# 单次检测超时；超时即放行，不阻塞回答
SEC_CHECK_TIMEOUT=1.2
# 连续失败几次后熔断（熔断期间直接放行，避免每条提问白等）
SEC_CHECK_FAIL_THRESHOLD=3
SEC_CHECK_CIRCUIT_SECONDS=300
# 仅本地联调时用：强制在非云托管环境也发检测请求
# SEC_CHECK_FORCE=1
