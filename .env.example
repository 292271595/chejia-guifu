# 复制为 .env 后填写（.env 已在 .gitignore，不会进仓库）
# 云端部署时不要用本文件，密钥填在云托管控制台的「环境变量」里。

# ── 生成（问答大模型）──
# 智谱 GLM-4-Flash：open.bigmodel.cn 注册即送额度，glm-4-flash 长期免费
GEN_BACKEND=zhipu
API_BASE=https://open.bigmodel.cn/api/paas/v4
MODEL=glm-4-flash
API_KEY=

# ── 嵌入（检索向量）──
# cloud = 硅基流动 BAAI/bge-m3（1024 维，免费，国内直连）
EMBED_BACKEND=cloud
EMBED_API_BASE=https://api.siliconflow.cn/v1
EMBED_MODEL=BAAI/bge-m3
EMBED_API_KEY=
# 查询期嵌入超时（秒）：必须远小于小程序 15s 硬上限，超时后自动降级纯 BM25
EMBED_TIMEOUT=8

# ── 其他 ──
# 后端在 15s 前主动降级的阈值
QUERY_TIMEOUT=12
# 可选：只允许这些 openid 提问（逗号分隔，留空=不限制）
OPENID_ALLOWLIST=

# ── 内容安全（上架审核硬要求）──
# 调用微信 msg_sec_check 检测用户提问与 AI 答案。
# 前提：云托管控制台「云调用 → 云调用权限配置」登记 /wxa/msg_sec_check。
# 本地开发自动跳过（检测不到容器内的 token 文件），无需改动本项。
SEC_CHECK_ENABLE=1
# 单次检测超时；超时即放行，不阻塞回答
SEC_CHECK_TIMEOUT=1.2
# 连续失败几次后熔断（熔断期间直接放行，避免每条提问白等）
SEC_CHECK_FAIL_THRESHOLD=3
SEC_CHECK_CIRCUIT_SECONDS=300
# 仅本地联调时用：强制在非云托管环境也发检测请求
# SEC_CHECK_FORCE=1

# ── 回答不准确上报（反馈台账）──
# 反馈导出接口口令。不配则 /api/feedback/export 返回 404，反馈只剩日志那一路。
FEEDBACK_TOKEN=
# 反馈推送地址。按域名自动选请求格式，支持企业微信、钉钉、飞书群机器人：
#   企业微信 https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxx
#   钉钉     https://oapi.dingtalk.com/robot/send?access_token=xxx
#   飞书     https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 这是反馈唯一能长期留存的一路（容器内 JSONL 会随重新发布清空），建议必配。
FEEDBACK_WEBHOOK=
# 飞书机器人开了「签名校验」才填。开了签名就不要再用「自定义关键词」——
# 关键词要求每条消息都含那几个字，而反馈内容由用户写，命中不了会被拒（code 19024）。
FEISHU_SECRET=
# 本地开发时反馈落盘目录（默认项目 data/feedback）
# FEEDBACK_DIR=
