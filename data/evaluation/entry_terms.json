{
  "meta": {
    "version": 1,
    "created_at": "2026-11-17",
    "rule": "新增入口词/入口短语必须登记在这里：至少两条正向同义问法、至少一条反向守卫问法。正向证明它该接住，反向证明它没有抢别的处理器。只写正向不算登记。",
    "why": "入口词是最容易复发的一类补丁。只加词不加守卫，回归只能等到旧题被抢答才发现；只测一个问法，也证明不了它覆盖的是一类而不是一句。",
    "checker": "tools/check_entry_terms.py（已接入 run_all_checks）"
  },
  "entries": [
    {
      "term": "满分",
      "handler": "q_full_score",
      "added_at": "2026-11-17",
      "why": "省略主语的“满分了怎么办”原先没有处理器认领；但卷面满分是另一件事，必须让位。",
      "positive": [
        {
          "q": "满分了怎么办",
          "expect": "FULL_SCORE"
        },
        {
          "q": "满分咋办",
          "expect": "FULL_SCORE"
        }
      ],
      "negative": [
        {
          "q": "科目一满分是多少",
          "expect_not": "FULL_SCORE",
          "why": "问卷面满分，不是记满12分"
        }
      ]
    },
    {
      "term": "一审",
      "handler": "q_vehicle / q_review",
      "added_at": "2026-11-17",
      "why": "口语“几年一审”既可能问车辆检验，也可能问驾驶证审验；只能让带车辆语境的进车辆层。",
      "positive": [
        {
          "q": "金杯9座几年一审",
          "expect": "VEHICLE:CYCLE"
        },
        {
          "q": "摩托车几年一审",
          "expect": "VEHICLE:CYCLE"
        }
      ],
      "negative": [
        {
          "q": "A1驾驶证几年一审",
          "expect": "REVIEW:AB",
          "why": "问驾驶证审验，不能被车辆检验接走"
        },
        {
          "q": "B2还要年审吗",
          "expect": "REVIEW:AB",
          "why": "“年审”整体归审验处理器，不进车辆层"
        }
      ]
    },
    {
      "term": "骑几年",
      "handler": "q_moto_scrap_years",
      "added_at": "2026-11-17",
      "why": "摩托车年限确认问法原先被注销登记流程抢答；扩的是年限确认，不是所有报废问法。",
      "positive": [
        {
          "q": "摩托车最多骑几年",
          "expect": "EDGE:MOTO_SCRAP_YEARS"
        },
        {
          "q": "摩托车还能骑几年",
          "expect": "EDGE:MOTO_SCRAP_YEARS"
        },
        {
          "q": "摩托车能骑多少年",
          "expect": "EDGE:MOTO_SCRAP_YEARS"
        },
        {
          "q": "摩托车能骑到哪年",
          "expect": "EDGE:MOTO_SCRAP_YEARS"
        }
      ],
      "negative": [
        {
          "q": "摩托车报废怎么办理",
          "expect": "REG:SCRAP",
          "why": "问流程仍归注销登记，不能抢成年限题"
        }
      ]
    },
    {
      "term": "刚/才拿到证",
      "handler": "q_internship",
      "added_at": "2026-11-17",
      "why": "用户不说“实习期”三个字，也可能在问实习期限制；但刚拿证问准驾范围必须留给车型处理器。",
      "positive": [
        {
          "q": "刚拿到驾驶证可以独自上高速吗",
          "expect": "INTERNSHIP:HIGHWAY"
        },
        {
          "q": "驾驶证才拿到，高速一个人上行不行",
          "expect": "INTERNSHIP:HIGHWAY"
        }
      ],
      "negative": [
        {
          "q": "刚取得C1能开什么车",
          "expect": "SCOPE:C1",
          "why": "问准驾范围，不是实习期限制"
        }
      ]
    },
    {
      "term": "报废车上路",
      "handler": "table_edge_scrap_drive_onroad",
      "added_at": "2026-11-18",
      "why": "线上两条真实错答：报废车上路被答成醉驾5年、第十四条、造成事故才吊销。根因是事实层无处理器覆盖第一百条的报废/拼装车上路处罚，掉进生成层被编造。本入口词接住「报废/拼装车上路+处罚/吊销/重考」整类，同时守卫醉驾、注销流程、3周期强制报废、摩托年限。",
      "positive": [
        {
          "q": "驾驶报废车辆上路会受到怎么样的处罚",
          "expect": "EDGE:SCRAP_DRIVE_ONROAD"
        },
        {
          "q": "报废车上路被查到怎么处罚",
          "expect": "EDGE:SCRAP_DRIVE_ONROAD"
        },
        {
          "q": "开报废车上路吊销驾照后多久能重考",
          "expect": "EDGE:SCRAP_DRIVE_ONROAD"
        },
        {
          "q": "拼装车上路怎么处罚",
          "expect": "EDGE:SCRAP_DRIVE_ONROAD"
        }
      ],
      "negative": [
        {
          "q": "醉驾吊销驾驶证后多久能重新考",
          "expect": "REVOKE:5",
          "why": "酒驾醉驾档是第九十一条5年，不能被报废车上路规则抢走"
        },
        {
          "q": "车辆报废了怎么办理注销登记",
          "expect": "REG:SCRAP",
          "why": "问报废流程仍归注销登记，不是上路处罚"
        },
        {
          "q": "连续三个检验周期没年检会强制报废吗",
          "expect": "EDGE:THREE_CYCLE_SCRAP",
          "why": "问未检强制报废归检验周期规则"
        },
        {
          "q": "摩托车最多能骑多少年",
          "expect": "EDGE:MOTO_SCRAP_YEARS",
          "why": "问摩托车使用年限，不是上路处罚"
        }
      ]
    },
    {
      "term": "考驾照年龄",
      "handler": "table_age_apply_all",
      "added_at": "2026-11-19",
      "why": "线上错答：「多大年龄可以考驾照」掉进生成层，编出「大型客车70岁以上需通过三力测试」。三力测试70岁以上只适用C1/C2/C5/F，大客车63周岁禁驾、延长最长3年。综合年龄问法必须由事实层接住并给出正确分档。",
      "positive": [
        {
          "q": "多大年龄可以考驾照",
          "expect": "AGE:APPLY_ALL"
        },
        {
          "q": "考驾照有年龄限制吗",
          "expect": "AGE:APPLY_ALL"
        },
        {
          "q": "多少岁能考驾驶证",
          "expect": "AGE:APPLY_ALL"
        },
        {
          "q": "申请驾驶证年龄条件",
          "expect": "AGE:APPLY_ALL"
        }
      ],
      "negative": [
        {
          "q": "大型客车驾照多大年龄能考",
          "expect": "AGE_APPLY:A1",
          "why": "点名大型客车，归单车型年龄规则，不能被总览抢走"
        },
        {
          "q": "C1驾照有年龄上限吗",
          "expect": "AGE_APPLY:C1",
          "why": "点名C1，归单车型规则"
        },
        {
          "q": "70岁能通过三力测试开大客车吗",
          "expect": "AGE_DRIVE:70:A1",
          "why": "问70岁驾驶资格，归驾驶年龄规则，答案是不能"
        },
        {
          "q": "C1增驾A2要几年",
          "expect": "ADD:A2",
          "why": "问增驾年限，不是申领年龄总览"
        }
      ]
    },
    {
      "term": "报名材料",
      "handler": "table_apply_material",
      "added_at": "2026-11-19",
      "why": "线上错答：报考驾照材料清单写「异地报考可能需要居住证明」。一证通考自2019-06-01起凭身份证异地申领、不再提交居住登记凭证。根因是事实层无处理器覆盖报名材料类问句，全部掉生成层，疑似把机动车登记的居住证明要求串到驾驶证报名。本入口词接住「报名/异地/一证通考+材料/居住证」整类，并守卫上牌、换证、增驾、境外人员。",
      "positive": [
        {
          "q": "报考驾驶证都要带什么",
          "expect": "APPLY:MATERIAL"
        },
        {
          "q": "考驾照报名需要什么材料",
          "expect": "APPLY:MATERIAL"
        },
        {
          "q": "异地报考驾照需要居住证明吗",
          "expect": "APPLY:MATERIAL"
        },
        {
          "q": "考驾照需要居住证吗",
          "expect": "APPLY:MATERIAL"
        },
        {
          "q": "一证通考是什么意思",
          "expect": "APPLY:MATERIAL"
        }
      ],
      "negative": [
        {
          "q": "外地人买车上牌要居住证吗",
          "expect_not": "APPLY:MATERIAL",
          "why": "上牌（机动车登记）确实要居住证明，与驾照报名相反，绝不能抢"
        },
        {
          "q": "异地换驾驶证要居住证吗",
          "expect_not": "APPLY:MATERIAL",
          "why": "换证业务材料与初次报名不同"
        },
        {
          "q": "C1增驾A2要什么材料",
          "expect_not": "APPLY:MATERIAL",
          "why": "增驾材料不是初次报名"
        },
        {
          "q": "70岁以上换证要带什么",
          "expect": "RENEW:AGE70",
          "why": "已有70岁换证处理器，不能被报名材料抢走"
        },
        {
          "q": "外国人考驾照需要什么材料",
          "expect": "OVERSEAS:CONVERT",
          "why": "境外人员身份证明规则不同，已有专门处理器"
        },
        {
          "q": "申请A1驾驶证需要多大年龄",
          "expect": "AGE_APPLY:A1",
          "why": "金标准G01抓到的抢答：问句里的「需要」曾被误判为材料诉求，报名材料行抢走年龄问句"
        }
      ]
    }
  ]
}