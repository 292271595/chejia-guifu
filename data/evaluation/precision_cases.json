{
  "meta": {
    "version": 1,
    "created_at": "2026-11-16",
    "purpose": "独立精准挑战集：分别检查理解路由、首段主结论、必要细节和错误结论，不再用全文关键词命中代替精准。",
    "split_rule": "dev 用于日常发现与修复；holdout 只在阶段验收时运行。同一 group 的所有问法必须处于同一 split，防止同一考点换说法后泄漏到两边。holdout 一旦查看失败明细并据此修复，就不得继续冒充完全未见数据，下一阶段须补新的考点组。",
    "result_rule": "expected_fact 精确约束路由；must_head 只查首段；must_anywhere 查全文必要细节；must_not_head 只查首段错误结论，避免消歧段误伤。",
    "basis_rule": "有 file 和 quote 的条目由执行器到知识库逐字核对；没有 quote 的条目仍须给 basis，但只算人工依据，不能冒充机器已核验。",
    "error_labels": {
      "exception": "执行异常",
      "no_answer": "空答案",
      "route_miss": "应命中确定事实却掉回检索层",
      "route_wrong": "命中了错误事实或相邻制度",
      "unexpected_fact": "本应交回检索层却被事实层抢答",
      "missing_head": "首段没有直接给出主结论",
      "missing_detail": "全文缺少关键条件、范围或例外",
      "forbidden_conclusion": "首段出现明确错误结论",
      "unexpected_abstain": "有确定依据却弃答"
    }
  },
